-    if (auth.usesKeystore()) {
+    // Android 12 及更早用 legacy 软件派生解密，key 目录里有 keymaster_key_blob 文件；
+    // Android 13+ 才走 keystore2（依赖 /data 里已解密的 keystore 数据库）。
+    // recovery 里 /data 尚未解密，走 keystore2 必然失败，这里按 blob 是否存在自动选择。
+    const bool has_keymaster_blob = pathExists(dir + "/" + kFn_keymaster_key_blob);
+    printf("TWRP-DBG: retrieveKey usesKeystore=%d has_keymaster_blob=%d dir=%s\n",
