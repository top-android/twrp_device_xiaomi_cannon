+    if (auth.usesKeystore() && !has_keymaster_blob) {
         Keystore keystore;
-        if (!keystore) return false;
+        if (!keystore) {
+            printf("TWRP-DBG: keystore2 unavailable\n");
+            return false;
+        }
         km::AuthorizationSet keyParams = beginParams(appId);
         if (!decryptWithKeystoreKey(keystore, dir, keyParams, encryptedMessage, key)) {
+            printf("TWRP-DBG: decryptWithKeystoreKey failed\n");
             LOG(ERROR) << "decryptWithKeystoreKey failed";
             return false;
         }
     } else {
         if (!decryptWithoutKeystore(appId, encryptedMessage, key)) {
+            printf("TWRP-DBG: decryptWithoutKeystore failed\n");
             LOG(ERROR) << "decryptWithoutKeystore failed";
             return false;
         }
+        printf("TWRP-DBG: metadata key decrypted via legacy keymaster path\n");
     }
     return true;
 }
